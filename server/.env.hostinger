# AOL TMS Server Configuration for Hostinger Cloud
# Copy this file to .env and update with your Hostinger details

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Update with your Hostinger MySQL details)
DB_HOST=your-hostinger-mysql-host.mysql.hostinger.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=5

# Authentication (IMPORTANT: Generate secure secrets!)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_FOR_PRODUCTION
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TIMEOUT_MINUTES=480

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png,gif,doc,docx

# Email Configuration (Configure with your SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Encryption (IMPORTANT: Generate secure key!)
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_ENCRYPTION_KEY_FOR_PRODUCTION

# Frontend URL (Update with your domain)
FRONTEND_URL=https://your-domain.com

# Hostinger Specific Settings
# If using Hostinger's Node.js hosting, you may need to adjust these:
# PORT=process.env.PORT || 5000
# DB_CONNECTION_LIMIT=3  # Lower limit for shared hosting
