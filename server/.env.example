# AOL TMS Backend Environment Configuration
# Copy this file to .env and update with your settings

# =============================================
# SERVER CONFIGURATION
# =============================================
PORT=5000
NODE_ENV=development
APP_NAME="AOL TMS"
APP_VERSION=2.0.0

# =============================================
# DATABASE CONFIGURATION (XAMPP/Cloud MySQL)
# =============================================
# For XAMPP (Local Development)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aol_tms
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_TIMEOUT=60000

# For Hostinger Cloud (Production)
# DB_HOST=your-hostinger-mysql-host.mysql.hostinger.com
# DB_USER=your_mysql_username
# DB_PASSWORD=your_mysql_password

# =============================================
# ZERO TRUST SECURITY CONFIGURATION
# =============================================
# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Password Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Session Security
SESSION_TIMEOUT_MINUTES=480
MAX_CONCURRENT_SESSIONS=3
IDLE_TIMEOUT_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60
MFA_TOKEN_EXPIRES_SECONDS=300

# =============================================
# ENCRYPTION & SECURITY
# =============================================
# Data Encryption
ENCRYPTION_KEY=your_super_secure_encryption_key_change_in_production_32_chars
ENCRYPTION_ALGORITHM=aes-256-gcm

# Security Headers
SECURITY_CONTENT_SECURITY_POLICY=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_FRAMEGUARD=deny

# =============================================
# FILE UPLOAD CONFIGURATION
# =============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png,gif,doc,docx,xlsx,csv
UPLOAD_PATH=./uploads
UPLOAD_VIRUS_SCAN=false

# =============================================
# EMAIL CONFIGURATION
# =============================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="AOL TMS <noreply@alloverlogistics.com>"

# =============================================
# MONITORING & LOGGING
# =============================================
# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=100m

# Error Tracking
SENTRY_DSN=
ERROR_REPORTING_ENABLED=true

# =============================================
# EXTERNAL SERVICES
# =============================================
# Geolocation
GEOLOCATION_API_KEY=
GEOLOCATION_ENABLED=false

# SMS Service (for MFA)
SMS_API_KEY=
SMS_FROM_NUMBER=
SMS_ENABLED=false

# =============================================
# DEVELOPMENT SETTINGS
# =============================================
# Development flags
DEBUG_MODE=true
MOCK_EXTERNAL_SERVICES=true
SKIP_SSL_VERIFICATION=false

# Testing
TEST_DATABASE_NAME=aol_tms_test
TEST_JWT_SECRET=test_jwt_secret_for_testing_only

# =============================================
# PRODUCTION SETTINGS
# =============================================
# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000
# For production: https://your-domain.com

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_URL=/api/docs

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_URL=/health

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System maintenance in progress. Please try again later."
