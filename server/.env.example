# AOL TMS Server Configuration
# Copy this file to .env and configure for your MySQL provider

# =================================================================
# SERVER CONFIGURATION
# =================================================================
PORT=5000
NODE_ENV=development

# =================================================================
# DATABASE CONFIGURATION - Works with any MySQL provider
# =================================================================
# Local Development (XAMPP, WAMP, MAMP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aol_tms
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Production Examples:
# Hostinger: DB_HOST=your-host.mysql.hostinger.com
# DigitalOcean: DB_HOST=your-host.db.ondigitalocean.com
# AWS RDS: DB_HOST=your-instance.region.rds.amazonaws.com
# Google Cloud SQL: DB_HOST=your-ip-address
# Azure: DB_HOST=your-server.mysql.database.azure.com
# cPanel/WHM: DB_HOST=localhost (usually)
# Any provider: Update DB_HOST, DB_USER, DB_PASSWORD accordingly

# =================================================================
# SECURITY & AUTHENTICATION
# =================================================================

# Authentication
JWT_SECRET=aol_tms_super_secret_key_change_in_production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TIMEOUT_MINUTES=480

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png,gif,doc,docx

# Email Configuration (configure with your SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Encryption
ENCRYPTION_KEY=aol_tms_encryption_key_change_in_production

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000
# For production: FRONTEND_URL=https://your-domain.com
