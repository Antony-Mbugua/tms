# AOL TMS Backend Environment Configuration
# Development/Demo Environment

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (XAMPP Compatible)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aol_tms
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# JWT Configuration
JWT_SECRET=aol_tms_jwt_secret_development_min_32_chars_for_security
JWT_REFRESH_SECRET=aol_tms_refresh_secret_development_min_32_chars_for_security
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Configuration
ENCRYPTION_KEY=aol_tms_encryption_key_32_chars_dev

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Redis Configuration (optional for development)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email Configuration (optional for development)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aol-tms.com

# File Upload Configuration
UPLOAD_MAX_SIZE=10mb
UPLOAD_PATH=uploads

# Logging Configuration
LOG_LEVEL=debug

# Security Configuration
SESSION_SECRET=aol_tms_session_secret_development_min_32_chars
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000

# Development Features
DEBUG=true
MOCK_MODE=true
